#!/usr/bin/env bash
# One entry point for Archon work on the Galatea portal, for humans, Claude Code
# and the Hermes bot alike.
#
# Two engines sit behind it and they are not interchangeable:
#   * The pinned SDLC pack (archon-ship, archon-triage, ...) runs through the
#     factory consumer, which owns the gates and refuses anything not in the pin.
#   * Project workflows in .archon/workflows/ (galatea-implementation-audit) are
#     invisible to the factory by design, so they run against the pinned CLI
#     directly. The pin is still read from .factory/consumer.json -- never an
#     ambient archon binary, and never a hardcoded SHA.
set -euo pipefail

REPO="${GALATEA_REPO:-/root/galatea-system-stagin}"
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"

# Archon's Claude provider refuses permissionMode `bypassPermissions` under UID 0
# unless IS_SANDBOX=1 is set (the ClaudeProvider constructor in the pinned
# packages/providers/src/claude/provider.ts). This host runs everything as root,
# so without it a run dies at its first agent node -- triage__triage -- and skips
# the whole DAG behind it. Set here rather than at each call site so Telegram,
# Claude Code and a human at the terminal all get it without remembering a prefix.
if [ "$(id -u)" = "0" ]; then
  export IS_SANDBOX=1
fi

die() { echo "galatea-archon: $*" >&2; exit 1; }

[ -d "$REPO/.git" ] || die "no repository at $REPO (set GALATEA_REPO)"
[ -f "$REPO/.factory/consumer.json" ] || die "$REPO has no factory pin"

SOURCE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["source"])' \
  "$REPO/.factory/consumer.json")"
[ -d "$SOURCE" ] || die "pinned Archon source is missing: $SOURCE"

factory() { (cd "$REPO" && python3 factory/consumer.py "$@"); }
native()  { (cd "$REPO" && bun "$SOURCE/packages/cli/src/cli.ts" "$@" --cwd "$REPO"); }

# --- reaping spent worktrees ------------------------------------------------
# Every archon-ship run clones a fresh worktree and never reaps it. Each one is
# ~860MB (656MB of that is node_modules), so nine spent runs had quietly taken
# 10.6GB of a 96GB disk before the first sweep. A worktree is spent once its
# work is in main -- either as an ancestor of origin/main, or squash-merged
# behind a closed PR, which leaves the branch tip looking unmerged to git.
#
# Two rules keep this safe to run unattended:
#   * Anything with uncommitted changes is never touched, whatever its PR says.
#   * Branch refs are always kept. They cost bytes, not gigabytes, and they are
#     the only undo button once the worktree is gone.
reap() {
  local quiet=0 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet)   quiet=1; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "reap: unknown flag $1" ;;
    esac
  done

  [ "${GALATEA_ARCHON_NO_REAP:-0}" = "1" ] && return 0

  git -C "$REPO" fetch --quiet --prune origin >/dev/null 2>&1 || true
  local main_sha
  main_sha="$(git -C "$REPO" rev-parse --verify --quiet origin/main || true)"
  [ -n "$main_sha" ] || { [ "$quiet" = "1" ] || echo "reap: no origin/main to compare against"; return 0; }

  local primary
  primary="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)"

  local reaped=0 kept=0 freed=0
  local w n br head size pr reason

  # git itself is the registry -- it knows about ~/.archon worktrees and
  # /root/runs ones alike, and lists the primary checkout first so it is
  # skipped by the toplevel comparison below.
  while IFS= read -r w; do
    [ -n "$w" ] && [ -d "$w" ] || continue
    n="$(basename "$w")"
    [ "$(git -C "$w" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" = "$primary" ] || continue
    [ "$(git -C "$w" rev-parse --show-toplevel 2>/dev/null)" = "$(git -C "$REPO" rev-parse --show-toplevel)" ] && continue

    if [ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ]; then
      [ "$quiet" = "1" ] || echo "  keep   $n — uncommitted changes"
      kept=$((kept + 1)); continue
    fi

    br="$(git -C "$w" branch --show-current 2>/dev/null || true)"
    head="$(git -C "$w" rev-parse HEAD 2>/dev/null || true)"

    reason=""
    if [ -n "$head" ] && git -C "$REPO" merge-base --is-ancestor "$head" "$main_sha" 2>/dev/null; then
      reason="in origin/main"
    elif [ -n "$br" ]; then
      pr="$(cd "$REPO" && gh pr list --head "$br" --state merged --limit 1 \
              --json number --jq '.[0].number' 2>/dev/null || true)"
      [ -n "$pr" ] && [ "$pr" != "null" ] && reason="squash-merged as #$pr"
    fi

    if [ -z "$reason" ]; then
      [ "$quiet" = "1" ] || echo "  keep   $n — not merged yet"
      kept=$((kept + 1)); continue
    fi

    size="$(du -sm "$w" 2>/dev/null | cut -f1)"; size="${size:-0}"
    if [ "$dry" = "1" ]; then
      echo "  would reap $n — $reason (${size}MB)"
    else
      git -C "$REPO" worktree remove --force "$w" >/dev/null 2>&1 || { rm -rf "$w"; }
      echo "  reaped $n — $reason (${size}MB freed, branch ${br:-?} kept)"
    fi
    reaped=$((reaped + 1)); freed=$((freed + size))
  done < <(git -C "$REPO" worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')

  git -C "$REPO" worktree prune >/dev/null 2>&1 || true

  if [ "$reaped" -gt 0 ]; then
    local verb="reaped"; [ "$dry" = "1" ] && verb="would reap"
    echo "galatea-archon: $verb $reaped worktree(s), ${freed}MB, $kept kept"
  elif [ "$quiet" != "1" ]; then
    echo "galatea-archon: nothing to reap ($kept worktree(s) kept)"
  fi
}

usage() {
  cat <<'USAGE'
galatea-archon — Archon on the Galatea portal

  audit [area] [--publish preview|approve|auto] [--max N] [--detach]
        Is everything in MISSION.md actually implemented? Read-only by default;
        publishes GitHub issues only with --publish approve (gated) or auto.
        Areas: "Membership and identity" | Forum | "Quantum XIII progression"
               | Broadcasts | "Terminal and content" | "Engineering quality"

  backlog <doc> [--publish preview|approve|auto] [--max N] [--detach]
        Slice a product spec into an ordered GitHub backlog. Use for a whole
        feature or spec — one work item is `ship`, not this. The document must
        be text in the repo (Markdown, not .docx).

  ship "<issue or request>"      Take ONE work item to a reviewed PR (gated).
  triage "<issue or request>"    Is it ready to build? Advisory, writes nothing.
  run <workflow> [args...]       Any other pinned SDLC workflow.

  reap [--dry-run]  Delete worktrees whose work already landed in main. Runs
                    automatically before and after `ship`; branch refs and any
                    worktree with uncommitted changes are always kept.

  report            Show the newest audit report.
  list | doctor     What is installed, and is the pin healthy.
  status | get <run-id> | approve <run-id> | reject <run-id> | respond <run-id>
  cancel <run-id> | resume <run-id> | halt | unhalt

  Add --detach to audit/ship/run to return a run id immediately (use this from
  chat); follow it with: galatea-archon get <run-id>
USAGE
}

case "${1:-}" in
  audit)
    shift
    area=""; publish="preview"; max="15"; extra=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --publish) publish="${2:?--publish needs a mode}"; shift 2 ;;
        --max)     max="${2:?--max needs a number}"; shift 2 ;;
        --*)       extra+=("$1"); shift ;;
        *)         area="$1"; shift ;;
      esac
    done
    native workflow run galatea-implementation-audit \
      --input "area=$area" --input "publication=$publish" --input "max_gaps=$max" \
      ${extra[@]+"${extra[@]}"}
    ;;
  backlog)
    shift
    prd="${1:-}"; [ -n "$prd" ] || die "backlog needs a product document path inside the repo"
    shift
    publish="preview"; max="12"; extra=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --publish) publish="${2:?--publish needs a mode}"; shift 2 ;;
        --max)     max="${2:?--max needs a number}"; shift 2 ;;
        *)         extra+=("$1"); shift ;;
      esac
    done
    # A binary document (.docx, .pdf) reaches the planner as replacement
    # characters; the checked-in Markdown twin is the readable one.
    case "$prd" in
      *.docx|*.doc|*.pdf|*.pptx|*.xlsx)
        die "$prd is binary; point at the Markdown version (e.g. xp-rules/${prd%.*}.md)" ;;
    esac
    [ -f "$REPO/$prd" ] || die "no such document in the repo: $prd"
    factory run archon-backlog --input "prd=$prd" --input "publication=$publish" \
      --input "max_issues=$max" ${extra[@]+"${extra[@]}"}
    ;;
  ship)
    shift; [ $# -gt 0 ] || die 'ship needs a request: galatea-archon ship "fix #12"'
    target="$1"; shift
    # Before: this run is about to clone another ~860MB worktree, so free the
    # spent ones first. After: this run's own worktree is reapable the moment
    # its PR lands, and nobody comes back later to sweep.
    reap --quiet
    factory run archon-ship --input "target=$target" "$@"
    reap --quiet
    ;;
  triage)
    shift; [ $# -gt 0 ] || die 'triage needs a request'
    target="$1"; shift
    factory run archon-triage --input "target=$target" "$@"
    ;;
  run)     shift; [ $# -gt 0 ] || die "run needs a workflow name"; factory run "$@" ;;
  reap)    shift; reap "$@" ;;
  report)
    latest="$(ls -1dt "$HOME"/.archon/workspaces/*/*/artifacts/runs/*/gaps.md 2>/dev/null | head -1 || true)"
    [ -n "$latest" ] || die "no audit report yet — run: galatea-archon audit"
    echo "# $latest"; cat "$latest"
    ;;
  list|doctor|status|get|approve|reject|respond|cancel|resume|halt|unhalt)
    factory "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; die "unknown command: $1" ;;
esac
